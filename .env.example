# Copie para .env (local) ou cadastre em Vercel → Project → Settings → Environment Variables.
# Nunca coloque segredos no código nem no GitHub.

# ID do contêiner do Google Tag Manager (público, não é segredo).
# Se vazio, o site usa o contêiner já configurado em src/lib/tracking/config.ts.
VITE_GTM_ID=

# URL canônica do site (sem barra no final). Padrão: https://parquedasflores.life
VITE_SITE_URL=

# --- Integrações de CRM (opcional, somente servidor) ---
# Se definida, cada lead enviado com sucesso também é encaminhado (POST JSON) para esta URL.
LEAD_WEBHOOK_URL=
# Segredo opcional enviado no cabeçalho "X-Webhook-Secret" para o CRM validar a origem.
LEAD_WEBHOOK_SECRET=
