# Copie para .env (local) ou cadastre em Vercel → Project → Settings → Environment Variables.
# Nunca coloque segredos no código nem no GitHub.

# ID do contêiner do Google Tag Manager (público, não é segredo).
# Se vazio, o site usa o contêiner já configurado em src/lib/tracking/config.ts.
VITE_GTM_ID=

# URL canônica do site (sem barra no final). Padrão: https://parquedasflores.life
VITE_SITE_URL=

# --- Formulário de contato (somente servidor) ---
# Sem nenhuma variável abaixo, o formulário envia pelo Formspree "mbgjjlle"
# (o destinatário é o e-mail cadastrado no painel do Formspree).
# Para usar outro formulário do Formspree:
FORMSPREE_FORM_ID=

# Para enviar pelo Resend (as três precisam estar preenchidas):
# chave criada em resend.com → API Keys
RESEND_API_KEY=
# quem recebe os leads (pode ter mais de um, separados por vírgula)
LEAD_EMAIL_TO=
# remetente de um domínio verificado no Resend, ex.: Parque das Flores <site@seudominio>
LEAD_EMAIL_FROM=

# --- Integrações de CRM (opcional, somente servidor) ---
# Se definida, cada lead enviado com sucesso também é encaminhado (POST JSON) para esta URL.
LEAD_WEBHOOK_URL=
# Segredo opcional enviado no cabeçalho "X-Webhook-Secret" para o CRM validar a origem.
LEAD_WEBHOOK_SECRET=
